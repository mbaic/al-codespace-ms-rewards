{
  "name": "bc-al-codespace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dynamics-smb.al",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-vscode.powershell",
        "GitHub.vscode-pull-request-github",
        "SShadowSdk.al-lsp-for-agents"
      ],
      "settings": {
        "al.enableCodeAnalysis": true,
        "al.incrementalBuild": true,
        "al.packageCachePath": ".alpackages",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "postCreateCommand": "echo '⚠️  Please fork this repo first and create a Codespace from your fork. See README.' && node --version && pwsh --version && gh --version"
}